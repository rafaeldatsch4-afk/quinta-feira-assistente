{
  "name": "Quinta-Feira — Cérebro",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quinta-feira",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1f0c6c2-0001-4c1e-9a10-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "quinta-feira"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.chatInput }}",
        "options": {
          "systemMessage": "=Você é a Quinta-Feira, uma assistente pessoal inteligente no estilo do J.A.R.V.I.S. Fale sempre em português do Brasil, com tom confiante, prestativo e levemente bem-humorado. Chame o usuário de {{ $json.body.usuario || 'Chefe' }}. Suas respostas são lidas em voz alta, então seja direta: no máximo 3 frases curtas, sem markdown, listas ou emojis, a não ser que o usuário peça detalhes. Data e hora atuais do usuário: {{ $json.body.horaLocal || $now.setZone('America/Sao_Paulo').toFormat(\"cccc, dd 'de' LLLL 'de' yyyy, HH:mm\") }}. Use isso para saudações e perguntas sobre horário."
        }
      },
      "id": "a1f0c6c2-0002-4c1e-9a10-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "a1f0c6c2-0003-4c1e-9a10-000000000003",
      "name": "Modelo de Chat",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        180,
        220
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').item.json.body.sessionId }}",
        "contextWindowLength": 12
      },
      "id": "a1f0c6c2-0004-4c1e-9a10-000000000004",
      "name": "Memória",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        360,
        220
      ]
    },
    {
      "parameters": {
        "resource": "audio",
        "operation": "generate",
        "model": "tts-1",
        "input": "={{ $json.output }}",
        "voice": "nova",
        "options": {
          "response_format": "mp3"
        }
      },
      "id": "a1f0c6c2-0006-4c1e-9a10-000000000006",
      "name": "Gerar voz",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "data",
        "destinationKey": "audio",
        "options": {}
      },
      "id": "a1f0c6c2-0007-4c1e-9a10-000000000007",
      "name": "Áudio em base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"output\": $('AI Agent').item.json.output, \"audio\": $json.audio, \"audioMime\": \"audio/mpeg\" } }}",
        "options": {}
      },
      "id": "a1f0c6c2-0005-4c1e-9a10-000000000005",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1040,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Gerar voz",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Modelo de Chat": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Memória": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Gerar voz": {
      "main": [
        [
          {
            "node": "Áudio em base64",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Áudio em base64": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
