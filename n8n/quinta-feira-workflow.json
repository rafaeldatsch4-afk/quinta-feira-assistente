{
  "name": "Quinta-Feira — Cérebro",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quinta-feira",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1f0c6c2-0001-4c1e-9a10-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "quinta-feira"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.chatInput }}",
        "options": {
          "systemMessage": "=Você é a Quinta-Feira, uma assistente pessoal inteligente no estilo do J.A.R.V.I.S. Fale sempre em português do Brasil, com tom confiante, prestativo e levemente bem-humorado. Chame o usuário de {{ $json.body.usuario || 'Chefe' }}. Suas respostas são lidas em voz alta, então seja direta: no máximo 3 frases curtas, sem markdown, listas ou emojis, a não ser que o usuário peça detalhes. Data e hora atuais do usuário: {{ $json.body.horaLocal || $now.setZone('America/Sao_Paulo').toFormat(\"cccc, dd 'de' LLLL 'de' yyyy, HH:mm\") }}. Use isso para saudações e perguntas sobre horário."
        }
      },
      "id": "a1f0c6c2-0002-4c1e-9a10-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "a1f0c6c2-0003-4c1e-9a10-000000000003",
      "name": "Modelo de Chat",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        180,
        220
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').item.json.body.sessionId }}",
        "contextWindowLength": 12
      },
      "id": "a1f0c6c2-0004-4c1e-9a10-000000000004",
      "name": "Memória",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        360,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"gemini-3.8-flash-tts\", \"input\": [{ \"type\": \"user_input\", \"content\": [{ \"type\": \"text\", \"text\": $json.output, \"annotations\": [{ \"type\": \"speech_metadata\", \"style\": \"natural, simpática e confiante, em português do Brasil\" }] }] }], \"response_format\": { \"type\": \"audio\", \"mime_type\": \"audio/wav\" }, \"generation_config\": { \"speech_config\": [{ \"voice\": \"Kore\" }] } } }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1f0c6c2-0006-4c1e-9a10-000000000006",
      "name": "Gerar voz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"output\": $('AI Agent').item.json.output, \"audio\": ($json.steps || []).filter(s => s.type === 'model_output').flatMap(s => s.content || []).filter(c => c.type === 'audio').map(c => c.data).pop() || null, \"audioMime\": \"audio/wav\" } }}",
        "options": {}
      },
      "id": "a1f0c6c2-0005-4c1e-9a10-000000000005",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        820,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Gerar voz",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Modelo de Chat": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Memória": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Gerar voz": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
